# Secret names only, never values. Copy to .env (git-ignored).

# Written by `dotnet run --project src/Budgeter -- claim`; never paste it by hand into chat.
SIMPLEFIN_ACCESS_URL=
# Anthropic key for Sonnet (categories, budget, roasts).
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5).
BUDGETER_MODEL=
# Telegram, for watch: bot token from @BotFather. TELEGRAM_CHAT_ID is written by `telegram link`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Twilio SMS instead of Telegram (needs an approved A2P 10DLC campaign). E.164 numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BUDGETER_TO_NUMBER=
