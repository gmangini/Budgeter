# Secret names only, never values. Copy to .env (git-ignored).

# Written by `dotnet run --project src/Budgeter -- claim`; never paste it by hand into chat.
SIMPLEFIN_ACCESS_URL=
# Anthropic key for Sonnet (categories, budget, roasts).
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5).
BUDGETER_MODEL=
# Twilio, for watch (texts go only to BUDGETER_TO_NUMBER). E.164 numbers, e.g. +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BUDGETER_TO_NUMBER=
